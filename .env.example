# Ativar somente após verificar disponibilidade e configuração oficial do segundo turno.
TSE_ENABLED=false
TSE_POLL_DELAY_MS=30000
BACKEND_PORT=8080

# Ativar após criar o bucket e configurar credencial limitada a ele.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=results/
