# Modelo para Nginx instalado no host. Não substituir a configuração global.
# Habilitar somente após conferir DNS, porta livre e proxy atual da VPS.
server {
    listen 80;
    server_name brasildecide.pablo-soares.tech;

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
